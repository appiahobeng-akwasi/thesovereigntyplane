---
import summary from '../data/summary.json';

/*
  Quadrant membership is derived from the tracker export at build time so the
  legend copy can never drift from the scores shown on the Plane above it.
  (It previously hard-coded counts and country names from an earlier tracker
  version.)
*/
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight',
  'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen'];

const core = summary.filter((s) => s.sample_group === 'Core sample');
const coreCount = core.length;
const inQuadrant = (q: string) => core.filter((s) => s.quadrant === q).map((s) => s.country);
const listNames = (names: string[]) =>
  names.length <= 1 ? names.join('') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;

const theatreNames = inQuadrant('theatre');
const interdepNames = inQuadrant('interdep');
const adhocNames = inQuadrant('adhoc');
const dependNames = inQuadrant('depend');

const countSentence = (names: string[]) =>
  `${WORDS[names.length]} of ${WORDS[coreCount].toLowerCase()} African states sit here.`;

const namedSentence = (names: string[], noneText: string) =>
  names.length === 0
    ? noneText
    : names.length === 1
      ? `Only ${names[0]} among the African sample.`
      : `${WORDS[names.length]} African cases: ${listNames(names)}.`;

const quadrants = [
  {
    id: 'theatre',
    marker: 'Above the diagonal',
    name: 'Sovereignty Theatre',
    description:
      `Strategies, laws, and institutions accumulate faster than the capacity to enforce, evaluate, or renegotiate. ${countSentence(theatreNames)}`,
    color: 'var(--theatre)',
    colorSoft: 'var(--theatre-soft)',
  },
  {
    id: 'interdep',
    marker: 'At or near diagonal, upper',
    name: 'Negotiated Interdependence',
    description:
      `Formal architecture matched by operational capacity. The state can enforce against major providers and bargain credibly. ${namedSentence(interdepNames, 'No African state in the current cohort sits here.')}`,
    color: 'var(--interdep)',
    colorSoft: 'var(--interdep-soft)',
  },
  {
    id: 'adhoc',
    marker: 'Below the diagonal',
    name: 'Ad-Hoc Capability',
    description:
      `Capacity outruns formal architecture. Ecosystems, private investment, or diaspora networks generate capability without state-led planning. ${namedSentence(adhocNames, 'No African state in the current cohort sits here.')}`,
    color: 'var(--adhoc)',
    colorSoft: 'var(--adhoc-soft)',
  },
  {
    id: 'depend',
    marker: 'Lower-left',
    name: 'Dependency by Default',
    description:
      `Limited formal architecture and limited substantive capacity. The state is a passive recipient of AI systems built, governed, and operated elsewhere. ${countSentence(dependNames)}`,
    color: 'var(--depend)',
    colorSoft: 'var(--depend-soft)',
  },
];
---

<section class="legend" id="quadrants">
  <div class="legend-header">
    <span class="legend-section-label">&sect;02 &middot; Reading it / Four quadrants</span>
    <h2 class="legend-title">Four <em>quadrants,</em> one coherence line.</h2>
    <p class="legend-lede">
      The plane is a diagnostic, not a verdict. What matters is not where a state currently sits but
      the direction of its movement&thinsp;&mdash;&thinsp;toward the diagonal where declaration and
      capacity coincide, or away from it.
    </p>
  </div>

  <div class="quadrant-grid">
    {
      quadrants.map((q) => (
        <article class={`quad-card quad-card--${q.id}`} style={`--card-color: ${q.color}; --card-soft: ${q.colorSoft};`}>
          <div class="quad-card-marker">
            <span class="quad-card-dot" />
            <span class="quad-card-marker-text">{q.marker}</span>
          </div>
          <h3 class="quad-card-name">{q.name}</h3>
          <p class="quad-card-desc">{q.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* ── Legend section ── */
  .legend {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad);
    padding-top: calc(120px * var(--ts));
    padding-bottom: calc(120px * var(--ts));
    border-top: 1px solid var(--rule);
  }

  /* ── Header block ── */
  .legend-header {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: var(--rail-gap);
    margin-bottom: calc(72px * var(--ts));
  }

  .legend-section-label {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: calc(10px * var(--ts));
    color: var(--ink-mute);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 10px;
  }

  .legend-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, calc(64px * var(--ts)));
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 24px;
  }

  .legend-title em {
    font-style: italic;
  }

  .legend-lede {
    font-family: 'Inter Variable', sans-serif;
    font-size: calc(15px * var(--ts));
    font-weight: 400;
    color: var(--ink-2);
    line-height: 1.6;
    max-width: calc(600px * var(--ts));
    letter-spacing: -0.003em;
  }

  /* ── Quadrant grid ── */
  /*
    The label rail is empty visually for the grid —
    cards sit in a 2-column sub-grid inside the content column,
    offset by the rail width so they line up with the header copy.
  */
  .quadrant-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-left: calc(var(--rail) + var(--rail-gap));
    gap: calc(20px * var(--ts));
  }

  /* ── Card ── */
  .quad-card {
    background: var(--card-soft);
    border: 1px solid var(--rule-soft);
    padding: calc(32px * var(--ts)) calc(28px * var(--ts)) calc(28px * var(--ts));
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: border-color 200ms;
  }

  .quad-card:hover {
    border-color: var(--rule);
  }

  /* ── Marker row ── */
  .quad-card-marker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .quad-card-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--card-color);
    flex-shrink: 0;
  }

  .quad-card-marker-text {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: calc(10px * var(--ts));
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Name ── */
  .quad-card-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: calc(26px * var(--ts));
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 12px;
  }

  /* ── Description ── */
  .quad-card-desc {
    font-family: 'Inter Variable', sans-serif;
    font-size: calc(13.5px * var(--ts));
    font-weight: 400;
    color: var(--ink-2);
    line-height: 1.55;
    letter-spacing: -0.003em;
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .legend {
      padding-left: 32px;
      padding-right: 32px;
      padding-top: 80px;
      padding-bottom: 80px;
    }

    .legend-header {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 48px;
    }

    .legend-section-label {
      padding-top: 0;
    }

    .quadrant-grid {
      grid-template-columns: 1fr;
      margin-left: 0;
      gap: 16px;
    }

    .quad-card-name {
      font-size: 22px;
    }
  }
</style>
